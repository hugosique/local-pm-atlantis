# --- Required -------------------------------------------------------------

DATABASE_URI=mongodb://localhost:27018/local-pm

# Signs auth tokens. Generate a real one per install:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=local-pm-secret-key-for-development-only

NEXT_PUBLIC_SERVER_URL=http://localhost:3010

# --- Access control -------------------------------------------------------

# When false (the default), the REST/GraphQL API is fully OPEN: any client that
# can reach the port may read and write every ticket, project and team. That is
# fine for a tool bound to loopback on one machine and NOT fine for anything
# another host can reach.
#
# Set to true to require a logged-in user for every operation. Create the first
# account at /admin, then issue an API key per automated caller (the MCP server
# included) and send it as:
#
#     Authorization: users API-Key <key>
#
# Turning this on before your automation holds credentials will lock it out.
LOCAL_PM_REQUIRE_AUTH=false

# --- Docker ---------------------------------------------------------------

# Host port used by docker-compose.dev.yml; the dev app binds only to loopback.
LOCAL_PM_DEV_PORT=3011

# --- Uploads --------------------------------------------------------------

# Where attachments are written. Defaults to ./uploads next to the project.
# docker-compose sets this to /app/uploads and mounts a named volume there;
# point it at a path on a real disk if you keep the files outside the volume.
LOCAL_PM_UPLOADS_DIR=

# --- Cycles ---------------------------------------------------------------

# Projects with cycles enabled and rollover set to Automatic have their elapsed
# cycles closed, and their unfinished work moved on, by a job running inside the
# server process. It needs a long-lived Node process, so it works under
# `npm run start` and docker-compose but not on a serverless host — there, run
# `npm run migrate:cycles` from a scheduler instead.
#
# How often that job runs. Five fields: minute hour day-of-month month weekday.
LOCAL_PM_CYCLE_CRON=0 * * * *

# Set to true to stop the job entirely. Cycles then only advance when someone
# opens the cycles page, or closes a cycle by hand. The e2e suite sets this.
LOCAL_PM_DISABLE_CYCLE_CRON=false

# --- Tuning ---------------------------------------------------------------

# How long the driver waits to find a reachable database before failing.
# 10s suits both a compose-local mongo and a hosted cluster over the internet;
# lower it to fail faster locally, raise it for a slow remote cluster.
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
